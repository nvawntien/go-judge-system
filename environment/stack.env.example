# Compose interpolation values for /etc/astracode/stack.env on the VPS.
ASTRACODE_IMAGE_ROOT=ghcr.io/OWNER/go-judge-system
ASTRACODE_IMAGE_TAG=v0.1.0
ASTRACODE_EDGE_BIND=127.0.0.1
ASTRACODE_EDGE_PORT=8080
WORKER_POOL_SIZE=1

# Runtime secret files are provisioned on the VPS, never by CI/CD.
POSTGRES_ENV_FILE=/etc/astracode/postgres.env
REDIS_ENV_FILE=/etc/astracode/redis.env
SERVICE_ENV_FILE=/etc/astracode/service.env
GATEWAY_JWK_FILE=/etc/astracode/symmetric.json
