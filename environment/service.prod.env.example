# Copy to /etc/astracode/service.env with mode 0640 and a deployment-only group.
# Values marked REPLACE must never be committed with real credentials.

DATABASE_USER=astracode
DATABASE_PASSWORD=REPLACE_WITH_THE_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_THE_REDIS_PASSWORD

# JWT_ACCESS_SECRET must be the raw key represented by symmetric.json.
JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_REFRESH_SECRET

KAFKA_BROKERS=kafka:9092
KAFKA_JOB_TOPIC=judge.submission.jobs
KAFKA_RESULT_TOPIC=judge.submission.results
KAFKA_DLT_TOPIC=judge.submission.jobs.dlt

MINIO_ROOT_USER=astracode
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_MINIO_PASSWORD
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=astracode
MINIO_SECRET_KEY=REPLACE_WITH_THE_SAME_MINIO_PASSWORD
MINIO_USE_SSL=false
# Auth stores same-origin avatar paths such as /avatars/users/... .
MINIO_PUBLIC_URL=/

SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM_NAME=AstraCode
SMTP_FROM=REPLACE_WITH_VERIFIED_SENDER_ADDRESS

APP_FRONTEND_URL=https://REPLACE_WITH_PUBLIC_HOSTNAME
SSE_TICKET_SECRET=REPLACE_WITH_A_LONG_RANDOM_SSE_SECRET
SSE_ALLOWED_ORIGIN=https://REPLACE_WITH_PUBLIC_HOSTNAME

SERVER_MODE=release
LOGGER_LEVEL=info
