# Local development talks to Envoy on port 8080. Production intentionally
# omits this build-time value and uses same-origin /api and /events routes.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Optional: endpoint used by the workspace "Run" button (custom-test execution).
# The backend does not expose this yet — the UI degrades gracefully until it does.
NEXT_PUBLIC_RUN_ENDPOINT=/api/v1/submissions/run
