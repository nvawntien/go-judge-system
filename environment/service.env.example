# Safe local-development template. Never reuse these values in production.

DATABASE_USER=admin
DATABASE_PASSWORD=change-me-local-postgres
REDIS_PASSWORD=change-me-local-redis

# JWT_ACCESS_SECRET must match gateway/symmetric.json for local development.
JWT_ACCESS_SECRET=astracode-local-dev-access-secret-change-me
JWT_REFRESH_SECRET=astracode-local-dev-refresh-secret-change-me

KAFKA_BROKERS=kafka:9092
KAFKA_JOB_TOPIC=judge.submission.jobs
KAFKA_RESULT_TOPIC=judge.submission.results
KAFKA_DLT_TOPIC=judge.submission.jobs.dlt

MINIO_ROOT_USER=astracode
MINIO_ROOT_PASSWORD=change-me-local-minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=astracode
MINIO_SECRET_KEY=change-me-local-minio
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=AstraCode
SMTP_FROM=noreply@localhost

APP_FRONTEND_URL=http://localhost:3000
SSE_TICKET_SECRET=change-me-local-sse-ticket-secret
SSE_ALLOWED_ORIGIN=http://localhost:3000

SERVER_MODE=debug
LOGGER_LEVEL=debug
